{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api_tickets.php", "destination": "/api/admin/tickets" },
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],
  "functions": {
    "api/scan-document.ts": { "maxDuration": 60, "memory": 1024 },
    "api/ocr.ts": { "maxDuration": 60, "memory": 1024 },
    "api/chat-faq.ts": { "maxDuration": 30 },
    "api/admin/tickets.ts": { "maxDuration": 30 },
    "api/eval/upload.ts": { "maxDuration": 30 },
    "api/eval/detail.ts": { "maxDuration": 30 },
    "api/eval/batch.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/purge-tiket-foto", "schedule": "0 2 * * *" },
    { "path": "/api/cron/purge-eval-fotos", "schedule": "30 2 * * *" }
  ]
}
