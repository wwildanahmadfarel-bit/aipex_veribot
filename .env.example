# Contoh env AIPEX VeriBot (TRACKED, tanpa secret asli).
# Salin ke .env.local, buka komentar baris yang diperlukan, lalu isi nilai asli.
# Jangan commit .env.local atau menempelkan isinya ke chat/issue.

# OCR (salah satu wajib):
# GEMINI_API_KEY=AIza...
# NARA_ROUTE_API_KEY=sk-nry-...
# BYNARA_API_KEY=sk-...
# BYNARA_ROUTE_API_KEY=sk-...

# Database (server-only; JANGAN pakai prefix NEXT_PUBLIC_):
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_KEY=...            # alternatif nama lama; pakai service/secret key

# Auth petugas (username + password + refresh cookie):
# OFFICER_JWT_SECRET=<acak min 32 karakter; hex 32 byte disarankan>
# OFFICER_ACCESS_TTL_MS=28800000   # access JWT, default 8 jam
# OFFICER_SESSION_TTL_MS=28800000  # umur absolut sesi refresh, default 8 jam
# Rate limit login (default produksi 10 percobaan / 10 menit / IP).
# Untuk demo publik yang ramai, longgarkan sementara lalu kembalikan ke default:
# OFFICER_LOGIN_MAX=30
# OFFICER_LOGIN_WINDOW_MS=10000    # 10 detik; nilai aman 1000..86400000
# APP_ORIGIN=https://domain-anda.example   # origin frontend (CSRF/CORS)
# ADMIN_ORIGIN=                             # opsional, origin admin tambahan
# FORCE_SECURE_COOKIES=false                # true di HTTPS non-production (mis. tunnel)

# Arsip foto tiket (7 hari):
# FOTO_MASTER_KEY=<hex 64 char>
# TICKET_FOTO_RETENTION_DAYS=7
# CRON_SECRET=<acak>

# Dataset evaluasi foto asli batch ycwc-001 (bucket privat eval-fotos):
# Kunci TERPISAH dari FOTO_MASTER_KEY. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EVAL_MASTER_KEY=<hex 64 char>
# EVAL_RETENTION_DAYS=14
# EVAL_BATCH_ID=ycwc-001
