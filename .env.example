# Contoh env untuk deploy Vercel — isi nilai asli di
# Vercel Dashboard → Project → Settings → Environment Variables.
# JANGAN commit .env.local asli (berisi secret).

# Wajib salah satu untuk OCR:
GEMINI_API_KEY=
NARA_ROUTE_API_KEY=

# Opsional nara-route:
# NARA_ROUTE_BASE_URL=https://router.bynara.id/v1
# NARA_ROUTE_MODEL=auto

# Database tiket (wajib agar data persisten di serverless):
SUPABASE_URL=
SUPABASE_KEY=
# atau:
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
