# Contoh env AIPEX VeriBot (TRACKED, tanpa secret asli).
# Salin ke .env.local lalu isi nilai asli. Jangan commit .env.local.
# Lihat .env.contoh lokal untuk nilai deploy saat ini.

# OCR (salah satu wajib):
# GEMINI_API_KEY=AIza...
# NARA_ROUTE_API_KEY=sk-nry-...
# BYNARA_API_KEY=sk-...
# BYNARA_ROUTE_API_KEY=sk-...

# Database:
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...

# Auth petugas:
# OFFICER_JWT_SECRET=<hex 32 byte>

# Arsip foto tiket (7 hari):
# FOTO_MASTER_KEY=<hex 64 char>
# TICKET_FOTO_RETENTION_DAYS=7
# CRON_SECRET=<acak>

# Dataset evaluasi foto asli batch ycwc-001 (bucket privat eval-fotos):
# Kunci TERPISAH dari FOTO_MASTER_KEY. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EVAL_MASTER_KEY=<hex 64 char>
# EVAL_RETENTION_DAYS=14
# EVAL_BATCH_ID=ycwc-001
